# ─────────────────────────────────────────────────────────────────────────────
# NO EDITAR A MANO: se regenera con `npm run env:example` (scripts/env-example.mjs).
# En local: cp .env.example .env.local — nunca commitear valores reales.
#
# Obligatoria: MISSION_CONTROL_SECRET (sin ella la app no arranca en Production y
# el guard de proxy.ts responde 503). Las demás dependen de lo que use la app.
#
# Llaves del gateway SAP por tenant (no listadas: dependen de qué tenants usan la app):
#   {TENANT}_SAP_API_KEY, p.ej. TAMAPRINT_SAP_API_KEY, FLEXOIMPRESOS_SAP_API_KEY.
#   Se leen SOLO con getGatewayApiKey() de lib/env.ts; el tenant sale de la sesión.
# El clientId/appId del changelog NO van por env: salen de .changelogrc.json.
# ─────────────────────────────────────────────────────────────────────────────
# Generado desde el contrato de @ai4u/config (renderEnvExample). No pongas valores reales aquí.

# URL base del gateway sap-b1-backend (único borde con SAP B1).
# Clase: platform · Secreto: no
# Alias aceptados (obsoletos): BACKEND_URL, NEXT_PUBLIC_BACKEND_URL, SAP_B1_BACKEND_URL, KPIS_APP_URL
SAP_BACKEND_URL=

# Endpoint de ingesta de logs de @ai4u/platform.
# Clase: platform · Secreto: no
PLATFORM_INGEST_URL=

# Secreto para autenticar la ingesta de logs.
# Clase: platform · Secreto: sí
INGEST_SECRET=

# URL del servicio de changelog (pill de versión).
# Clase: platform · Secreto: no
# Alias aceptados (obsoletos): CHANGELOG_URL, NEXT_PUBLIC_CHANGELOG_SERVICE_URL
NEXT_PUBLIC_CHANGELOG_URL=

# API key del servicio de changelog.
# Clase: platform · Secreto: sí
CHANGELOG_API_KEY=

# URL del proyecto Supabase.
# Clase: platform · Secreto: no
# Alias aceptados (obsoletos): SUPABASE_URL
NEXT_PUBLIC_SUPABASE_URL=

# Anon key de Supabase (pública por diseño; la protección es RLS).
# Clase: platform · Secreto: no
# Alias aceptados (obsoletos): SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL de Mission Control (SSO y navegación entre módulos).
# Clase: platform · Secreto: no
# Alias aceptados (obsoletos): NEXT_PUBLIC_MC_URL
MISSION_CONTROL_URL=

# Secreto servicio-a-servicio con Mission Control / gateway (transitorio: Fase 3 lo reemplaza por OIDC).
# Clase: service · Secreto: sí
# Alias aceptados (obsoletos): MC_INTERNAL_SECRET, SAP_BACKEND_SECRET, BACKEND_SERVICE_SECRET
MISSION_CONTROL_SECRET=

# Nombre del servicio en los logs.
# Clase: service · Secreto: no
# Alias aceptados (obsoletos): PLATFORM_SERVICE
SERVICE_ID=

# Service role de Supabase (solo si la app escribe; salta RLS).
# Clase: service · Secreto: sí
# Alias aceptados (obsoletos): SUPABASE_SERVICE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Secreto que manda Vercel Cron; uno por proyecto.
# Clase: service · Secreto: sí
CRON_SECRET=

# Llave de esta app hacia el gateway SAP cuando la app es de un solo tenant (fallback de {TENANT}_SAP_API_KEY).
# Clase: service · Secreto: sí
# Alias aceptados (obsoletos): SAP_B1_BACKEND_API_KEY
SAP_BACKEND_API_KEY=
