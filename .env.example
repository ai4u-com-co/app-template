# ─────────────────────────────────────────────────────────────────────────────
# .env.example — SOLO nombres canónicos del contrato de env Ai4U (fase 1).
# Nunca commitear valores reales. En local: cp .env.example .env.local
# Todo se lee a través de lib/env.ts (canónico → alias legado con aviso).
#
# [SHARED] = será Shared Environment Variable del team `ai4u` en Vercel:
#            se VINCULA al proyecto, no se carga a mano en cada uno.
#            (Mientras la Fase 2 no esté hecha, hay que cargarlas por proyecto.)
# ─────────────────────────────────────────────────────────────────────────────

# ── platform — iguales para todas las apps ───────────────────────────────────
# [SHARED] URL base del gateway sap-b1-backend (único borde con SAP B1).
SAP_BACKEND_URL=
# [SHARED] Ingest de logs de @ai4u/platform. Van juntas; vacías en dev = solo consola.
PLATFORM_INGEST_URL=
# [SHARED] secreto
INGEST_SECRET=
# [SHARED] URL del changelog-service (pill de versión).
NEXT_PUBLIC_CHANGELOG_URL=
# [SHARED] secreto — key de escritura del changelog (hook pre-commit). Solo en local/CI, no en runtime.
CHANGELOG_API_KEY=
# [SHARED] Supabase de Mission Control — solo si la app lo usa (anon key es pública por diseño, RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [SHARED] URL de Mission Control (links de "volver al shell").
MISSION_CONTROL_URL=

# ── service — identidad de ESTA app (proyecto Vercel de la app) ──────────────
# secreto — verifica el handoff SSO (/api/mc-auth) y firma la cookie mc_session.
# Mismo valor que usa Mission Control para firmar el token de este servicio
# (MISSION_CONTROL_SECRET o MISSION_CONTROL_SECRET_<SERVICEID> en MC).
# OBLIGATORIA: en producción la app no arranca sin ella (lib/observability.ts).
MISSION_CONTROL_SECRET=
# clientId y appId en el changelog-service. appId = appId de .changelogrc.json
# (si se omite, cae a SERVICE_ID de lib/service.ts). Sin CLIENT no se muestra el pill.
NEXT_PUBLIC_CHANGELOG_CLIENT=
NEXT_PUBLIC_CHANGELOG_APP=
# Opcional: override del nombre del servicio en logs (default: lib/service.ts).
SERVICE_ID=
# Opcionales según la app:
# secreto — solo si la app escribe en Supabase.
SUPABASE_SERVICE_ROLE_KEY=
# secreto — solo si la app tiene Vercel Cron.
CRON_SECRET=
# secreto — llave hacia el gateway SOLO si la app es de un único tenant (fallback final).
SAP_BACKEND_API_KEY=

# ── tenant — una por tenant que use la app, prefijo = id del gateway en MAYÚSCULAS
# (TAMAPRINT, FLEXOIMPRESOS, MAGDALENA, ELDORADO, ESTUDIOINDIGO, MULTIHEALTH).
# Se resuelven SOLO con getGatewayApiKey() de lib/env.ts; el tenant sale de la sesión.
# secreto — debe coincidir con una llave aceptada por el gateway para ese tenant.
# Ejemplos (descomentar solo los tenants que realmente usan esta app):
# TAMAPRINT_SAP_API_KEY=
# FLEXOIMPRESOS_SAP_API_KEY=

# ── provider — credenciales externas propias de esta app (sin normalizar en v1)
# Ej.: IA por tenant {TENANT}_{PROVIDER}_API_KEY → AI4U_{PROVIDER}_API_KEY.
